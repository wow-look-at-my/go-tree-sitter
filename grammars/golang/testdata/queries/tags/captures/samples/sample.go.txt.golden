    pattern:  0, capture: 2 - definition.function, start: (25, 0), end: (43, 1), text: `func main() {
	values := []point{{1, 2}, {3, 4}}
	var parts []string
	for _, v := range values {
		parts = append(parts, v.String())
	}
	switch n := len(parts); {
	case n > 2:
		fmt.Println(strings.Join(parts, ";"))
	default:
		fmt.Println(raw, interpreted, 'x', 0x1f, 1e9)
	}
	go func() { _ = raw }()
	defer func() {
		if r := recover(); r != nil {
			panic(r)
		}
	}()
}`
